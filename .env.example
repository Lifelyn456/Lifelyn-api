PORT=4000
NODE_ENV=development
HOST=0.0.0.0
DATABASE_URL=postgresql://lifelyn:local-development-only@localhost:5432/lifelyn
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://127.0.0.1:3000
# Generate a cryptographically random secret with at least 32 bytes. Never commit it.
AUTH_JWT_SECRET=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET=lifelyn-records
OBJECT_STORAGE_ACCESS_KEY=lifelyn-local
OBJECT_STORAGE_SECRET_KEY=local-development-only
# Local development uses the built-in AES-GCM envelope-key wrapper below (KMS_MASTER_KEY_BASE64).
# Production must set this to "external" and configure KMS_SERVICE_URL/KMS_SERVICE_TOKEN instead;
# assertProductionConfiguration() enforces that regardless of what this file says.
KMS_PROVIDER=local
KMS_KEY_REF=secret-manager-key-reference
KMS_SERVICE_URL=
KMS_SERVICE_TOKEN=
# Exactly 32 random bytes, base64 encoded. Local development only; production uses an external KMS.
KMS_MASTER_KEY_BASE64=
# Exactly 32 random bytes, base64 encoded, independent from the KMS key.
FIELD_ENCRYPTION_KEY_BASE64=
# Malware scanning is mandatory before encryption. Choose a provider:
#   http  (default): set MALWARE_SCANNER_URL to an HTTPS scanning service that answers 422 for infected files.
#   clamd: a ClamAV daemon (docker-compose.dev.yml starts one). Set CLAMD_HOST, and optionally CLAMD_PORT and CLAMD_TIMEOUT_MS.
#          Configure clamd StreamMaxLength to at least 32M so 25 MiB uploads are not rejected.
MALWARE_SCANNER_PROVIDER=
MALWARE_SCANNER_URL=
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000
AI_BASE_URL=http://localhost:8000
# Must equal the AI service SERVICE_JWT_SECRET and contain at least 32 random bytes.
AI_SERVICE_JWT_SECRET=
AI_PIPELINE_VERSION=history-v1
WEBAUTHN_RP_ID=127.0.0.1
PROVIDER_VERIFIER_TOKEN=
ORG_VERIFIER_TOKEN=
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONSENT_CONTRACT_ID=
STELLAR_PROVIDER_CONTRACT_ID=
STELLAR_PROVIDER_AUTHORITY_ADDRESS=
STELLAR_RECORD_ATTESTATION_CONTRACT_ID=
STELLAR_ACCESS_RECEIPT_CONTRACT_ID=
STELLAR_ATTESTATION_ISSUER_ADDRESS=
STELLAR_SIGNER_SERVICE_URL=
STELLAR_SIGNER_SERVICE_TOKEN=

# --- Stellar signer service (src/signer, run with `pnpm start:signer`) ---
# The API presents STELLAR_SIGNER_SERVICE_TOKEN; the signer checks it against SIGNER_AUTH_TOKEN. They must match (at least 32 random bytes).
SIGNER_AUTH_TOKEN=
# Production: mount the seed as a secret file. STELLAR_SIGNER_SECRET (inline) is refused when NODE_ENV=production.
STELLAR_SIGNER_SECRET_FILE=
STELLAR_SIGNER_SECRET=
SIGNER_HOST=127.0.0.1
SIGNER_PORT=8787
# Keeps idempotency records across restarts. Use a persistent volume in production.
SIGNER_STATE_FILE=
SIGNER_CONFIRM_WAIT_MS=10000
